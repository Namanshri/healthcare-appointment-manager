# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# SQLite file location (created automatically)
DB_PATH=./data/followup.db

# Optional — if set, AI summaries are generated by calling the real Anthropic API.
# If left blank, the server falls back to deterministic mock AI generation
# (same behavior as the original frontend demo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
